# React 개발 환경
# false: FastAPI·GPT 실서버 연결 / true: 프론트엔드 Mock 사용
VITE_USE_MOCK=false
VITE_API_BASE_URL=same-origin
VITE_API_TIMEOUT_MS=30000
VITE_JOB_ANALYSIS_TIMEOUT_MS=180000
VITE_MOCK_SCENARIO=success
VITE_MOCK_LATENCY_MS=250

# Python AI 엔진 서버 전용
DATABASE_URL=sqlite:///./data/career_memory.db
APP_ENV=development
SESSION_COOKIE_NAME=career_memory_session
SESSION_LIFETIME_HOURS=168
FRONTEND_URL=http://localhost:5173
AI_PROVIDER=openai
CHAT_HISTORY_MESSAGE_LIMIT=40

# 파일 입력과 PDF 처리 한도
AI_MAX_FILE_MIB=25
AI_MAX_FILES_TOTAL_MIB=100
AI_MAX_PDF_PAGES=100
AI_EXPERIENCE_FILE_ANALYSIS_CHUNK_TOKENS=12000
AI_EXPERIENCE_FILE_ANALYSIS_CHUNK_OVERLAP_TOKENS=300
AI_EXPERIENCE_FILE_ANALYSIS_SUMMARY_TOKENS=8000

# 일반 챗봇 답변 출력 한도
AI_CHAT_MAX_TOKENS=8000
# 0에 가까울수록 일관적이고, 높을수록 표현이 다양해진다. 일반 대화만 0.3을 권장한다.
AI_CHAT_TEMPERATURE=0.3

# Gemini 구조화 출력 어댑터를 선택했을 때만 사용하는 한도
AI_STRUCTURED_OUTPUT_MAX_TOKENS=65536

# 챗봇 입력 문맥·검색·대화 요약 예산
AI_CHAT_INPUT_TOKEN_BUDGET=60000
AI_CHAT_RECENT_HISTORY_TOKENS=14000
AI_CHAT_ATTACHMENT_CONTEXT_TOKENS=14000
AI_CHAT_EXPERIENCE_CONTEXT_TOKENS=10000
AI_CHAT_EVIDENCE_CONTEXT_TOKENS=12000
AI_CHAT_SUMMARY_TRIGGER_TOKENS=16000
AI_CHAT_SUMMARY_KEEP_RECENT_MESSAGES=12
AI_CHAT_EXPERIENCE_TOP_K=5
AI_CHAT_EVIDENCE_TOP_K=6
AI_JOB_MATCH_MIN_SCORE=0.65
AI_EVIDENCE_CHUNK_TOKENS=900
AI_EVIDENCE_CHUNK_OVERLAP_TOKENS=120

# Provider별 모델
GEMINI_MODEL=gemini-3.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# API 키
# 현재 AI_PROVIDER=openai이므로 OPENAI_API_KEY는 필수
# Gemini로 되돌릴 때만 GEMINI_API_KEY가 필요
OPENAI_API_KEY=
GEMINI_API_KEY=
