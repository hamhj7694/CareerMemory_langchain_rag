# React 개발 환경
VITE_USE_MOCK=true
VITE_API_BASE_URL=http://localhost:8000
VITE_API_TIMEOUT_MS=30000
VITE_MOCK_SCENARIO=success
VITE_MOCK_LATENCY_MS=250

# Python AI 엔진 서버 전용
# 실제 키는 이 파일이 아닌 로컬 .env에 입력한다.
DATABASE_URL=sqlite:///./data/career_memory.db
APP_ENV=development
SESSION_COOKIE_NAME=career_memory_session
SESSION_LIFETIME_HOURS=168
FRONTEND_URL=http://localhost:5173
AI_PROVIDER=gemini
CHAT_HISTORY_MESSAGE_LIMIT=40
GEMINI_API_KEY=
# 일반 챗봇 답변과 경험·공고 구조화 결과의 출력 한도를 따로 관리한다.
AI_CHAT_MAX_TOKENS=4000
AI_STRUCTURED_OUTPUT_MAX_TOKENS=32000
GEMINI_MODEL=gemini-3.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
