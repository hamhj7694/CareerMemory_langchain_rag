# Copy to .env.deploy. Never commit the filled file.
APP_ENV=production
SITE_DOMAIN=career.example.com
FRONTEND_URL=https://career.example.com
AI_PROVIDER=openai
OPENAI_API_KEY=
GEMINI_API_KEY=
# Enable only after setting provider billing limits and testing authentication.
AI_ENABLED=false
AI_DAILY_OPERATION_LIMIT=100
AI_CHAT_MAX_TOKENS=2000
AI_STRUCTURED_OUTPUT_MAX_TOKENS=8000
AI_MAX_STRUCTURED_INPUT_CHARS=100000
AI_MAX_MEDIA_SECONDS=120
AI_CHAT_INPUT_TOKEN_BUDGET=16000
AI_CHAT_ATTACHMENT_CONTEXT_TOKENS=4000
AI_CHAT_EXPERIENCE_CONTEXT_TOKENS=3000
AI_CHAT_EVIDENCE_CONTEXT_TOKENS=3000
AI_CHAT_RECENT_HISTORY_TOKENS=4000
AI_MAX_FILE_MIB=25
AI_MAX_FILES_TOTAL_MIB=25
AI_MAX_PDF_PAGES=30
ATTACHMENT_MAX_USER_MIB=100
ATTACHMENT_MAX_TOTAL_MIB=2048
ATTACHMENT_MIN_FREE_MIB=1024
AI_FILE_EXTRACTION_CONCURRENCY=1
WEB_BROWSER_RENDER_ENABLED=false
WEB_MAX_URLS_PER_INPUT=2
WEB_MAX_EMBEDDED_IMAGES=1
