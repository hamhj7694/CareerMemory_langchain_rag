{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow", "Action": "ecr:GetAuthorizationToken", "Resource": "*"
    },
    {
      "Effect": "Allow",
      "Action": ["ecr:BatchGetImage", "ecr:GetDownloadUrlForLayer", "ecr:BatchCheckLayerAvailability"],
      "Resource": [
        "arn:aws:ecr:AWS_REGION:ACCOUNT_ID:repository/career-memory-api",
        "arn:aws:ecr:AWS_REGION:ACCOUNT_ID:repository/career-memory-web"
      ]
    }
  ]
}
